// ============================================================================
// test.config — 小规模测试数据运行配置
//
// 用法:
//   nextflow run main.nf -profile test
//
// 使用 test/data/ 下的合成数据集完整跑通预处理流程, 无需任何外部数据库或
// 参考基因组 —— 测试数据与 mini host 索引均由 test/data/make_test_data.py
// 生成 (数据文件被 .gitignore 排除, 脚本是可复现的真实来源)。
//
// 若 test/data/host_reference/ 尚未生成, 先执行:
//   python3 test/data/make_test_data.py --outdir test/data
//   bowtie2-build test/data/host_reference/mini_host.fa \
//                 test/data/host_reference/mini_host
// ============================================================================

params {
    // 输入: 合成双端数据 (2 样本 × 2000 read 对, 含已知比例宿主 reads)
    input      = "${projectDir}/test/data/samplesheet.csv"

    // 宿主参考: 合成 mini host 基因组的 Bowtie2 索引前缀
    host_index = "${projectDir}/test/data/host_reference/mini_host"

    outdir     = "${projectDir}/test/results"
    batch_id   = "test_run"

    // 测试资源限制 (保持小规模, 便于 CI 与本地快速验证)
    // 使用内存/时间字面量而非字符串 —— resourceLimits 需要 MemoryUnit/Duration
    threads    = 2
    max_cpus   = 2
    max_memory = 4.GB
    max_time   = 1.h

    // 测试时发布去宿主 reads, 便于人工核对结果
    save_host_removed = true

    // ---- 组装 (Phase 5) ----
    //
    // 测试数据的微生物基因组仅 60 kb, 每样本约 1200-1700 个 read 对
    // (≈ 4-6× 覆盖度), 且由 make_test_data.py 从基因组精确取样、不注入碱基
    // 错误。MEGAHIT 默认的 --min-count 2 会把只出现一次的 (k+1)-mer 当作测序
    // 错误滤除 —— 在这个深度下会丢掉约 1/6 的真实 k-mer, 把图打得很碎。
    //
    // 因此测试改用 --min-count 1: 数据本身无错误, 这里不是放宽标准, 而是让
    // 参数与数据的实际性质相符。真实数据请勿沿用此设置。
    megahit_min_count = 1

    // ---- 分箱 (Phase 7) ----
    //
    // 测试数据组装总长仅 ~46 kb (STATUS.md 实测: S01 82 contigs, S02 34 contigs),
    // 低于 MetaBAT2 默认的 -m 2500 (最小 contig 长度) 与 200 kb 最小 bin 尺寸,
    // 不调整阈值则一个 bin 都形成不了。
    //
    // MetaBAT2 硬限制: -m 最低 1500 (更低会报错 "Contig length < 1500 is not allowed"),
    // 因此 -m 只能降至 1500。-s 无硬限制, 降至 10 kb 以让小规模测试数据能形成 bin。
    //
    // 这是让参数与测试数据的实际规模相符, 不是放宽标准。真实样本请勿沿用:
    // 真实宏基因组组装总长通常数百 MB 到数 GB, MetaBAT2 的默认阈值已针对该规模优化。
    metabat2_min_contig_len = 1500   // MetaBAT2 硬限制 (默认 2500), 使测试数据的 contigs 能进入分箱
    metabat2_min_bin_size   = 10000  // 降至 10 kb (默认 200 kb), 使小规模测试数据能形成 bin

    // ---- 结果整合 (Phase 14) ----
    //
    // pathway_db: KO→pathway 两列映射 (无表头), 由 make_test_data.py 生成的
    // 合成夹具 (3 行, test_pathway_* 标签) —— 只验证 Phase 14 Pathway 列 join
    // 的接线与格式解析, 不代表真实通路注释。缺失时 Pathway 列留空也是合法行为,
    // 但测试配置显式接入以保证该参数项处于测试覆盖之下。
    pathway_db = "${projectDir}/test/data/pathway_test.tsv"

    // ---- Phase 6-13 其余参数: 默认值即测试值, 此处不覆盖 ----
    //
    // Phase 6 (比对/覆盖度): bowtie2_*_args / save_* 默认空/关闭即测试值;
    //   coverage_min_* 保持 null —— contig 长度过滤是 MetaBAT2 自身的职责
    //   (见 nextflow.config 该段注释), 测试不得提前截断深度矩阵。
    // Phase 8-12 (QC/去冗余/分类/基因预测/注释): *_args 默认空串即测试值;
    //   mag_min_completeness=50 / mag_max_contamination=10 与 coverm_method=
    //   relative_abundance 沿用默认。Phase 8/10/12 的数据库依赖在测试配置中
    //   不可用 (真实库数 GB 起), 其分支拓扑由 -stub-run + 假路径覆盖
    //   (见 STATUS.md 测试矩阵), 真实执行标记 database-dependent。
    // 所有 skip_* 开关保持 false (默认), 由各测试命令按需经命令行传入 ——
    // 测试矩阵逐条记录实际组合。
}
