// ============================================================================
// slurm.config — 集群调度环境 (使用 SLURM)
//
// 用法:
//   nextflow run main.nf -profile slurm --slurm_queue <partition>
//   或与容器组合: nextflow run main.nf -profile singularity,slurm
//
// 通过 SLURM 提交任务; 每个 task 的 cpus/memory/time 由 conf/base.config 中的
// 资源 label (process_single/low/medium/high) 决定, 此处只配置调度行为。
// ============================================================================

// 参数须在 process 块之前定义 —— 配置文件自上而下求值, 否则下方引用取到 null
params {
    slurm_queue   = null    // SLURM partition (各集群命名不同, 按需指定)
    slurm_options = ''      // 追加的 sbatch 参数 (如 --account=xxx --qos=yyy)
}

process {
    executor = 'slurm'

    // 队列/分区: 通过命令行指定而非硬编码 —— 不同集群分区名不同
    queue = params.slurm_queue

    clusterOptions = params.slurm_options
}

executor {
    name = 'slurm'

    // 轮询与提交节流: 避免大规模 fan-out (如逐 MAG 注释) 压垮调度器
    pollInterval    = '30 sec'
    queueSize       = 100
    submitRateLimit = '10/1min'
}
