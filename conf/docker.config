// ============================================================================
// docker.config — 本地开发/测试环境 (使用 Docker 容器)
//
// 用法:
//   nextflow run main.nf -profile docker -c conf/docker.config
//
// 所有生物信息学软件在 Docker 容器中运行, 保证可重复性。
// ============================================================================

docker.enabled = true

process.container = 'nextflow-metagenomics:latest'
