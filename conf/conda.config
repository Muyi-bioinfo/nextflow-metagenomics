// ============================================================================
// conda.config — 使用 Conda/Mamba 管理分析软件
//
// 用法:
//   nextflow run main.nf -profile conda --input <samplesheet.csv>
//
// 各 process 通过 `conda` 指令声明自身依赖 (见 modules/local/**/*.nf),
// Nextflow 在首次运行时自动创建并缓存环境。
//
// 与 docker/singularity profile 的关系:
//   三者提供同一套软件的不同交付方式, process 内同时声明 conda 与 container,
//   由 profile 决定实际使用哪一种。
// ============================================================================

conda.enabled = true

// 优先使用 mamba 求解依赖 (显著快于 classic conda solver)
conda.useMamba = true

// 环境缓存目录: 跨 run 复用已创建的环境, 避免每次重建
conda.cacheDir = "${projectDir}/.conda_cache"

// 环境创建超时 (大型环境首次求解可能较慢)
conda.createTimeout = '2 h'
