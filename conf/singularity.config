// ============================================================================
// singularity.config — 服务器/HPC 环境 (使用 Singularity/Apptainer)
//
// 用法:
//   nextflow run main.nf -profile singularity -c conf/singularity.config
//
// 与 docker.config 类似, 但使用 Singularity/Apptainer 容器运行时。
// 后续Phase中, 各 process 通过 container 指令指定所需镜像。
// ============================================================================

singularity.enabled = true

// 镜像缓存目录 (可配置, 预留)
singularity.cacheDir = "${params.outdir}/../.singularity_cache"
