// ============================================================================
// base.config — 全局基础配置
// 所有 profile 共享; 不包含 profile 特定内容。
// ============================================================================

// ---------------------------------------------------------------------------
// 资源分配
//
// 各 process 通过 label 声明资源等级 (nf-core 惯例), 避免在模块内硬编码具体
// 数值 —— 同一套模块因此可以在笔记本和 SLURM 集群上复用。
//
// 封顶机制: resourceLimits 指令 (Nextflow 24.04+) 声明硬上限, 超出的请求由
// Nextflow 自动下调至该上限, 重试提升资源时同样受限。
//
// 写成闭包的原因: 本文件由 nextflow.config 中的 includeConfig 引入, 而该
// include 位于 profiles 块之前 —— 直接赋值会在 profile 加载前求值, 固化默认
// 上限, 使 -profile test 等对 max_* 的覆盖失效。闭包延迟到 task 提交时求值,
// 此时所有 profile 与命令行参数均已生效 (与各模块 publishDir 的处理一致)。
// ---------------------------------------------------------------------------
process {

    resourceLimits = {[
        cpus:   params.max_cpus,
        memory: params.max_memory,
        time:   params.max_time
    ]}

    // 未声明 label 的 process 使用的默认值
    cpus   = params.threads
    memory = { 6.GB * task.attempt }
    time   = { 4.h  * task.attempt }

    // 单线程轻量任务 (如样本表验证、指标汇总)
    withLabel: process_single {
        cpus   = 1
        memory = { 2.GB * task.attempt }
        time   = { 2.h  * task.attempt }
    }

    // 低资源任务 (如 FastQC, MultiQC)
    withLabel: process_low {
        cpus   = 2
        memory = { 4.GB * task.attempt }
        time   = { 4.h  * task.attempt }
    }

    // 中等资源任务 (如 fastp, Bowtie2 宿主去除)
    withLabel: process_medium {
        cpus   = params.threads
        memory = { 8.GB * task.attempt }
        time   = { 8.h  * task.attempt }
    }

    // 高资源任务 (后续 Phase: MEGAHIT, GTDB-Tk 等)
    // 超出 max_cpus 时由 resourceLimits 自动下调, 无需在此夹逼
    withLabel: process_high {
        cpus   = 16
        memory = { 16.GB * task.attempt }
        time   = { 16.h  * task.attempt }
    }

    // ---------------------------------------------------------------------
    // 个别工具在 label 之上的内存补充 (Phase 17 资源审计, 2026-09-08)
    // 本机/CI 由 resourceLimits 封顶, 不影响小规模运行; 集群上调
    // max_memory 后这些请求即生效。数值为固定请求而非 ×attempt ——
    // 两个工具的 OOM 都是数据库规模决定的, 重试升级内存无意义。
    // ---------------------------------------------------------------------
    withName: KRAKEN2 {
        // 默认 --kraken2_memory_mapping false 时数据库整库载入内存,
        // 标准库需 40-70 GB, process_high 的 16 GB 对真实库明显不足
        memory = 64.GB
    }
    withName: GTDBTK {
        // classify_wf 的 pplacer 内存峰值随输入 MAG 数增长,
        // 官方建议 60+ GB, 16 GB 对批处理明显不足
        memory = 64.GB
    }

    // ---------------------------------------------------------------------
    // 错误处理
    // 仅对内存/资源类退出码重试 (重试时 task.attempt 递增, 内存随之提升);
    // 其余错误立即终止, 避免掩盖真实的工具或参数问题。
    // ---------------------------------------------------------------------
    errorStrategy = { task.exitStatus in [104, 134, 137, 138, 139, 140, 143] ? 'retry' : 'terminate' }
    maxRetries    = 2
}
