// ============================================================================
// nextflow-metagenomics — 主配置文件
//
// 配置加载顺序 (后加载覆盖先加载):
//   nextflow.config → conf/base.config → conf/<profile>.config
//
// 支持 profiles: docker, singularity, slurm, test
// 所有路径参数需通过命令行 (--param value) 或 samplesheet 提供，
// 不得硬编码用户特定路径。
// ============================================================================

// ---------------------------------------------------------------------------
// 参数定义 (Phase 1: 预留, 后续 Phase 使用)
// ---------------------------------------------------------------------------
params {
    // 输入/输出
    input = null                    // samplesheet.csv: sample,fastq_1,fastq_2,group,batch,host
    outdir = "results"
    batch_id = null                 // 每次 run 属于一个独立 batch, 输出到 results/<batch_id>/
    threads = 4                     // 默认线程数, 后续 process 可覆盖

    // ---- 组装 (Phase 5) ----
    // megahit 与 metaspades 是**可选替代**组装器, 不是流水线的两级。
    // "both" 表示两者并行各跑一次, 产出两套独立 contigs 供横向比较。
    assembler = "megahit"           // "megahit" | "metaspades" | "both"
    assembly_mode = "single"        // "single" | "coassembly"(尚未实现, 显式报错)

    // MEGAHIT
    megahit_min_contig_len = 200    // 输出 contig 的最短长度 (MEGAHIT 默认 200)
    megahit_k_list = null           // 如 "21,29,39,59,79,99,119,141"; 与 megahit_preset 互斥
    megahit_preset = null           // "meta-sensitive" | "meta-large"; 与 megahit_k_list 互斥
    megahit_min_count = null        // (k+1)-mer 最小丰度, MEGAHIT 默认 2; 极低深度数据可设为 1
    megahit_args = ''               // 追加给 megahit 的额外参数

    // metaSPAdes (要求双端 library —— 单端样本会被分流并警告)
    metaspades_k = null             // 如 "21,33,55"
    metaspades_args = ''            // 追加给 spades.py 的额外参数
    save_assembly_graph = false     // 发布 metaSPAdes 的 assembly graph (GFA, 体积大)

    // QUAST —— 组装 QC (不是 MAG QC, 后者由 Phase 8 的 CheckM2 负责)
    quast_min_contig = 500          // 计入统计的最短 contig 长度 (QUAST 默认 500)
    quast_args = ''                 // 追加给 quast.py 的额外参数

    // ---- 比对与覆盖度 (Phase 6) ----
    // 参考序列是本次组装出的 contigs (从通道来), 因此本段没有任何参考路径参数。
    bowtie2_build_args = ''         // 追加给 bowtie2-build 的额外参数
    bowtie2_map_args = ''           // 追加给 bowtie2 的额外参数 (如 '--no-unal' 丢弃未比对记录)
    save_bowtie2_index = false      // 发布 contigs 的 Bowtie2 索引 (可再生的中间产物, 默认不发布)
    save_bam = false                // 发布排序 BAM + BAI (真实样本单个可达数十 GB, 默认不发布)

    // jgi_summarize_bam_contig_depths (随 MetaBAT2 发布) 的过滤阈值。
    // 默认 null = 沿用工具默认值, 不在此处过滤: contig 长度过滤是 MetaBAT2 自身的
    // 职责 (Phase 7, -m 默认 2500), 提前砍掉会让同一份深度矩阵无法被其他下游复用。
    coverage_min_contig_len = null  // --minContigLength
    coverage_min_depth = null       // --minContigDepth

    // 参考序列
    host_index = null               // Bowtie2 host genome index 前缀 (不含 .1.bt2 后缀)
    skip_host_removal = false       // 无 host index 时跳过宿主去除 (clean reads 直通下游)

    // 预处理 (fastp)
    fastp_qualified_quality = 15    // 单碱基合格质量阈值 (Q15)
    fastp_unqualified_percent = 40  // 允许的不合格碱基百分比上限
    fastp_min_length = 50           // 过滤后最短 read 长度
    fastp_cut_mean_quality = 20     // 滑窗切除的平均质量阈值
    fastp_dedup = false             // 是否启用 fastp 去重
    save_trimmed = true             // 发布 fastp 清洁 reads
    save_host_removed = false       // 发布去宿主后的 FASTQ (体积大, 默认不发布)

    // 跳过开关
    skip_fastqc = false
    skip_multiqc = false
    skip_read_based = false         // 总开关: 跳过整个 read-based 分支 (仅做组装)
    skip_kraken2 = false
    skip_bracken = false
    skip_humann = false
    skip_assembly = false           // 总开关: 跳过整个组装分支 (仅做 read-based 分析)
    skip_quast = false              // 跳过组装 QC (连带跳过 assembly_summary.tsv)
    skip_mapping = false            // 跳过 reads 比对与覆盖度 (连带使 Phase 7 分箱无输入)

    // ---- 分箱 (Phase 7) ----
    // V1 只实现 MetaBAT2; V2 接入 MaxBin2 / CONCOCT / DAS Tool 时 binner 参数启用。
    skip_binning = false            // 跳过整个分箱分支 (连带使 Phase 8+ MAG 相关分析无输入)
    skip_mag_qc = false             // 跳过 CheckM2 质控，直接传递 MAG
    checkm2_args = ''               // 追加给 checkm2 predict 的额外参数

    // ---- MAG 去冗余 (Phase 9) ----
    // dRep dereplicate 是集合级批处理: 一次调用处理本阶段全部 qualified MAG
    // (MASH 预筛 + FastANI 精算, 随 dRep 环境自带, 无外部数据库依赖)。按 ANI
    // 聚类后每簇选一个代表, 打分使用 Phase 8 CheckM2 的 completeness/
    // contamination —— 因此 dRep 依赖 QC 输出 (--skip_mag_qc 时需同时
    // --skip_dereplication, 由 DREP 子工作流守卫报错)。注意 drep_args 不要
    // 覆盖 -g / --genomeInfo / -p, 输出目录由模块固定传入。
    skip_dereplication = false      // 跳过 dRep 去冗余: 代表集 = 全部 qualified MAG, 成员表为恒等映射
    drep_args = ''                  // 追加给 dRep dereplicate 的额外参数

    // ---- MAG 分类 (Phase 10) ----
    // GTDB-Tk classify_wf 是批处理工具: 一次调用处理本阶段全部输入 MAG ——
    // 执行顺序为先去冗余后分类 (Phase 9 dRep), 故正常路径下输入是代表 MAG
    // 集合 (聚合与成员回填逻辑见 subworkflows/local/taxonomy.nf)。参考库通过
    // gtdbtk_db 指定 (见下方"数据库"段), 需 GTDB-Tk 2.x 兼容版本 (R220+,
    // 解压后约 110 GB); 缺失时按 Phase 8 守卫方式明确报错。注意 gtdbtk_args
    // 不要覆盖 --genome_dir / --out_dir / -x / --prefix, 它们由模块固定传入。
    skip_taxonomy = false           // 跳过 GTDB-Tk 分类 (不产出 mag_taxonomy.tsv)
    gtdbtk_args = ''                // 追加给 gtdbtk classify_wf 的额外参数

    // ---- 基因预测 (Phase 11) ----
    // Prodigal 逐代表 MAG 运行 (-p meta 宏基因组模式), 每个 MAG 产出
    // genes.fna / proteins.faa / GFF。无外部数据库依赖。注意 prodigal_args
    // 不要覆盖 -i / -a / -d / -f / -o / -p, 它们由模块固定传入。
    skip_gene_prediction = false    // 跳过基因预测 (连带使 Phase 12 功能注释无输入)
    prodigal_args = ''              // 追加给 prodigal 的额外参数

    // ---- 功能注释 (Phase 12) ----
    // 三支彼此独立的并行分支 (DIAMOND blastp ∥ eggNOG-mapper ∥ RGI), 唯一
    // 输入是 Phase 11 的 proteins.faa, 逐代表 MAG 运行。数据库分别经
    // diamond_db / eggnog_db / card_db 传入 (见下方"数据库"段), 缺失且未加
    // 对应 skip 时按 Phase 8/10 守卫方式明确报错, 不静默跳过。RGI 的卡库
    // (card.json) 由 RGI_LOAD 一次性 `rgi load --card_json ... --local`
    // 载入本地库后供全部 RGI_MAIN 任务使用 (rgi main 本身不接收数据库路径
    // 参数; 容器部署时可在镜像内预载入)。注意各 *_args 不要覆盖模块固定
    // 传入的参数 (diamond 的 --db/--query/--out/--outfmt; emapper 的
    // -i/-o/--output_dir/-m/--data_dir/--cpu; rgi 的 -i/-o/-t/-a/--local/
    // --clean/--threads), 它们由模块固定传入。
    skip_annotation = false          // 总开关: 跳过整个功能注释阶段
    skip_diamond = false             // 跳过 DIAMOND blastp 注释 (不产出 diamond_hits.tsv)
    skip_eggnog = false              // 跳过 eggNOG-mapper 注释 (不产出 eggnog_annotations.tsv)
    skip_rgi = false                 // 跳过 RGI (CARD) 注释 (不产出 rgi_annotations.tsv)
    diamond_args = ''                // 追加给 diamond blastp 的额外参数
    eggnog_args = ''                 // 追加给 emapper.py 的额外参数
    rgi_args = ''                    // 追加给 rgi main 的额外参数

    // ---- MAG 丰度 (Phase 13) ----
    // CoverM genome 集合级批处理: 全部代表 MAG + 全部样本 Phase 6 排序 BAM
    // 一次调用产出跨样本丰度矩阵 (行 = mag_id, 列 = 样本)。BAM 直接复用
    // Phase 6 产物 (MAG FASTA 的 contig header 原样保留, 与 BAM 一致),
    // 无需重新比对。无外部数据库依赖 (CoverM 自带比对器)。注意 coverm_args
    // 不要覆盖 --bam-files / --genome-fasta-files / --methods /
    // --output-file / --threads, 它们由模块固定传入; 多方法逗号列表会让矩阵
    // 每样本多列, Phase 14 整合不支持, 请保持单方法。
    skip_abundance = false            // 跳过 MAG 丰度 (不产出 13_abundance 矩阵)
    coverm_method = 'relative_abundance'  // CoverM --methods 值 (默认相对丰度 0-1)
    coverm_args = ''                  // 追加给 coverm genome 的额外参数

    // ---- 结果整合 (Phase 14) ----
    // 各 Phase 汇总表 join 为 14_integrated 下两张核心表 (mag_metadata.tsv /
    // mag_functional_annotation.tsv) + 引用拷贝 (成员表/组装汇总)。整合只
    // 消费上游通道, 无新增计算工具依赖; 每个输入表都可能因对应 --skip_*
    // 为空, 缺失时对应列留空 (行集合由存在表的并集决定)。pathway_db 为可选
    // 外部依赖 (KO→pathway 两列映射, 见下方"数据库"段), 未提供时
    // mag_functional_annotation.tsv 的 Pathway 列留空 (不虚构)。
    skip_integration = false          // 跳过结果整合 (不产出 14_integrated)

    binner = "metabat2"             // "metabat2" | "maxbin2" | "concoct" | "dastools" (V2 预留)
    metabat2_min_contig_len = null  // -m: 进入分箱的最小 contig 长度 (MetaBAT2 默认 2500)
    metabat2_min_bin_size = null    // -s: 最小 bin 尺寸 (MetaBAT2 默认 200000 = 200 kb)
    metabat2_seed = 42              // --seed: 固定随机种子以保证可重复 (MAG ID 稳定性依赖此参数)
    metabat2_args = ''              // 追加给 metabat2 的额外参数
    save_unbinned = false           // 发布 .unbinned.fa (体积大, 默认不发布)

    // ---- Read-based: Kraken2 (classification) ----
    // 数据库通过 kraken2_db 指定 (见下方"数据库"段), 不硬编码任何路径。
    kraken2_confidence = 0.0        // 置信度阈值 0-1; 提高可减少假阳性, 但会增加未分类 read
    kraken2_min_base_quality = 0    // 参与 k-mer 匹配的最低碱基质量 (reads 已过 fastp, 默认不再设限)
    kraken2_min_hit_groups = 2      // 判定为已分类所需的最少 k-mer 命中组数
    kraken2_memory_mapping = false  // true: 不把数据库读入内存 (省内存, 但显著变慢)
    save_kraken2_output = false     // 发布逐 read 分类结果 (真实样本可达数 GB, 默认不发布)

    // ---- Read-based: Bracken (abundance estimation) ----
    bracken_levels = "S,G"          // 估计丰度的分类层级, 逗号分隔; 代码: R/K/D/P/C/O/F/G/S(+子层级数字)
    bracken_read_length = 100       // 必须与 bracken-build -l 构建时使用的读长一致
    bracken_threshold = 10          // 层级内 read 数低于此值的分类单元不做重分配

    // ---- Read-based: HUMAnN (functional profiling) ----
    // HUMAnN 需要三个数据库, 因此 humann_db 不足以表达 (见 subworkflows/local/read_based.nf):
    //   humann_db 作为父目录便捷写法, 按 `humann_databases --download` 的布局推导
    //   <humann_db>/chocophlan 与 <humann_db>/uniref, 仅在子目录存在时采用;
    //   下面三个专用参数可逐个覆盖, MetaPhlAn 数据库必须显式给出。
    humann_nucleotide_db = null     // ChocoPhlAn 核酸数据库目录
    humann_protein_db = null        // UniRef 蛋白数据库目录 (含 .dmnd)
    metaphlan_db = null             // MetaPhlAn 数据库目录 (prescreen 用, 含 *.pkl)
    humann_args = ''                // 追加给 humann 的额外参数

    // 数据库 (Phase 1 预留, 后续 Phase 使用)
    //
    // 集中布局 (Phase 17): db_dir 非空时, 各工具 DB 按约定树派生默认值
    //   <db_dir>/kraken2、/humann (含 chocophlan/ uniref/ metaphlan/)、
    //   /checkm2、/gtdbtk、/diamond、/eggnog、/card、/pathway
    // (bracken 复用 kraken2 库内 kmer_distrib)。派生逻辑在 main.nf 顶部:
    // 派生前检查子目录存在, 不存在则维持 null (现有守卫照常报错);
    // 显式传参 (如 --gtdbtk_db /custom/path) 仍优先于派生默认。
    // 本地约定目录经 gitignored 的 conf/local.config 提供 (存在时自动
    // 读入, 见下方「本地便利配置与数据库集中布局」段 —— Nextflow 配置
    // 解析器不允许 if/try 语句, includeConfig 无法按文件存在性条件化,
    // 故用 ConfigSlurper 在顶层赋值表达式中读取), 仓库中不出现个人
    // 路径。布局完整文档见 Phase 18 docs/database.md。
    db_dir = null
    kraken2_db = null
    bracken_db = null               // 默认复用 kraken2_db —— kmer_distrib 通常就建在其中
    humann_db = null
    checkm2_db = null
    gtdbtk_db = null
    diamond_db = null               // NR 蛋白库 .dmnd (Phase 12 DIAMOND blastp)
    eggnog_db = null                // eggNOG 数据目录 (Phase 12 eggNOG-mapper)
    card_db = null                  // CARD card.json (Phase 12 RGI)
    pathway_db = null               // KO→pathway 两列映射 (Phase 14 Pathway 列, 可选; 缺失时留空)

    // MAG 质量过滤
    mag_min_completeness = 50
    mag_max_contamination = 10

    // ---- 结果可视化 (Phase 21) ----
    // 画图脚本只消费各 Phase 已产出的 TSV, 产出 PNG 到对应 Phase 的 figures/
    // 子目录 (有图才建)。database-dependent 图 (除 MAG 丰度热图外) 真实数据
    // 本地无库, 代码用 stub/合成表验证"能画", 真实图待库。
    plot_pathway_top = 50             // 通路丰度热图 top-N pathway 数 (图 ⑥)

    // 计算资源硬上限 (供 conf/base.config 的 resourceLimits 使用)
    // 必须定义在此处 —— 被 includeConfig 引入的配置只能看到 include 之前
    // 定义的 params。profile 与命令行可正常覆盖 (见 conf/test.config)。
    max_cpus   = 16
    max_memory = 10.GB
    max_time   = 24.h
}

// ---------------------------------------------------------------------------
// 本地便利配置与数据库集中布局 (Phase 17)
//
// 分两步, 全部写成顶层赋值语句 (Nextflow 配置解析器不允许混写 if/try):
//
// 1) db_dir 来源: 显式传参 (CLI / profile) > gitignored 的 conf/local.config
//    > 默认 null。local.config 用 ConfigSlurper 读取 —— 它是 Groovy 标准类,
//    在赋值表达式里可用 (实测); 文件不存在 (仓库/CI 环境) 时维持 null。
//    配置求值在 CLI 参数应用之后, 故 --db_dir /custom 优先于 local.config。
//
// 2) 各工具 DB 参数按约定树派生: <db_dir>/<工具> 子目录存在时取之, 不存在
//    或 db_dir 为 null 时维持 null —— 现有参数守卫照常报错。profile 配置
//    (后应用, 优先级更高) 与 CLI 的显式 *_db 参数会覆盖派生值, 显式优先。
//    bracken/chocophlan/uniref 不在此派生: read_based.nf 内已有
//    `bracken_db ?: kraken2_db` 与 humann_db 父目录推导, 自动跟随派生结果。
// ---------------------------------------------------------------------------
params.db_dir = params.db_dir ?: (new File("${projectDir}/conf/local.config").exists()
    ? new groovy.util.ConfigSlurper().parse(new File("${projectDir}/conf/local.config").toURI().toURL()).params.db_dir
    : null)

params.kraken2_db   = params.kraken2_db   ?: (params.db_dir && new File("${params.db_dir}/kraken2").exists() ? "${params.db_dir}/kraken2" : null)
params.humann_db    = params.humann_db    ?: (params.db_dir && new File("${params.db_dir}/humann").exists() ? "${params.db_dir}/humann" : null)
params.metaphlan_db = params.metaphlan_db ?: (params.db_dir && new File("${params.db_dir}/humann/metaphlan").exists() ? "${params.db_dir}/humann/metaphlan" : null)
params.checkm2_db   = params.checkm2_db   ?: (params.db_dir && new File("${params.db_dir}/checkm2").exists() ? "${params.db_dir}/checkm2" : null)
params.gtdbtk_db    = params.gtdbtk_db    ?: (params.db_dir && new File("${params.db_dir}/gtdbtk").exists() ? "${params.db_dir}/gtdbtk" : null)
params.diamond_db   = params.diamond_db   ?: (params.db_dir && new File("${params.db_dir}/diamond").exists() ? "${params.db_dir}/diamond" : null)
params.eggnog_db    = params.eggnog_db    ?: (params.db_dir && new File("${params.db_dir}/eggnog").exists() ? "${params.db_dir}/eggnog" : null)
params.card_db      = params.card_db      ?: (params.db_dir && new File("${params.db_dir}/card").exists() ? "${params.db_dir}/card" : null)
params.pathway_db   = params.pathway_db   ?: (params.db_dir && new File("${params.db_dir}/pathway").exists() ? "${params.db_dir}/pathway" : null)

// ---------------------------------------------------------------------------
// Batch ID 解析
//
// 每次 run 属于一个独立 batch, 结果输出到 <outdir>/<batch_id>/。
//
// 求值时机说明:
//   顶层 params 赋值在 profile 加载之前求值。若在此直接拼接
//   "${params.outdir}/${params.batch_id}", 会固化默认的 outdir, 使 profile
//   (如 -profile test) 对 outdir 的覆盖失效, 结果被写入错误目录。
//   因此各 process 的 publishDir 一律写成闭包形式:
//       publishDir { "${params.outdir}/${params.batch_id}/01_qc" }
//   闭包延迟到 task 提交时求值, 此时所有 profile 与命令行参数均已生效。
//
// 优先级: 命令行 --batch_id > profile > 自动默认值 batch_<YYYYMMDD>_001
// ---------------------------------------------------------------------------
params.batch_id = params.batch_id ?: "batch_${new java.text.SimpleDateFormat('yyyyMMdd').format(new Date())}_001"

// ---------------------------------------------------------------------------
// Workflow 基础设置
// ---------------------------------------------------------------------------
includeConfig 'conf/base.config'

// ---------------------------------------------------------------------------
// Profiles
// ---------------------------------------------------------------------------
profiles {
    conda {
        includeConfig 'conf/conda.config'
    }
    docker {
        includeConfig 'conf/docker.config'
    }
    singularity {
        includeConfig 'conf/singularity.config'
    }
    slurm {
        includeConfig 'conf/slurm.config'
    }
    test {
        includeConfig 'conf/test.config'
    }
}

// ---------------------------------------------------------------------------
// Docker (默认禁用, 由 conf/docker.config 中 profile 启用)
// ---------------------------------------------------------------------------
docker.enabled = false

// ---------------------------------------------------------------------------
// Workflow 运行报告 (通过命令行启用: -with-report -with-timeline -with-trace -with-dag)
// ---------------------------------------------------------------------------
report.enabled = false
timeline.enabled = false
trace.enabled = false
dag.enabled = false

// ---------------------------------------------------------------------------
// 可重复性
// ---------------------------------------------------------------------------
manifest {
    name = 'nextflow-metagenomics'
    author = 'Muyi-bioinfo'
    homePage = 'https://github.com/Muyi-bioinfo/nextflow-metagenomics'
    description = 'Production-grade shotgun metagenomics pipeline'
    version = '0.1.0'
    mainScript = 'main.nf'
}
